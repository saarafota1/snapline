# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Visual Studio / Rider / VS Code
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# OS
.DS_Store
Thumbs.db

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crash reports
sysinfo.txt
crashlytics-build.properties

# Signing keys - never commit
*.keystore
*.jks

# Unity build temp
/.utmp/
/StoreAssets/

# The benchmark harness project IS source, unlike Unity's generated csproj files above
!/Tools/**/*.csproj
/Tools/**/bin/
/Tools/**/obj/

# Design references are committed on purpose - they are the spec for the redesign.

# Sliced art is generated from the delivered sheets by Tools/ArtSlice.
# The sheets and the tool are the source of truth; regenerate rather than hand-edit.

# EDM4U resolver output: exploded .aar files, regenerated on every resolve
/Assets/GeneratedLocalRepo/
/Assets/GeneratedLocalRepo.meta
