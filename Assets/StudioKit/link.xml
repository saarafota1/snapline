<!--
  Preserves the StudioKit vendor adapters from the IL2CPP managed linker.

  The adapters self-register from [RuntimeInitializeOnLoadMethod] and nothing references them
  statically, so the linker deletes them and the game ships with no ads and no attribution while
  looking completely healthy. See PLAYBOOK, "IL2CPP strips every self-registering adapter".

  This file lives in Assets, not in the kit package: a link.xml inside a `file:` package was NOT
  honoured here (no mention in the build log, byte-identical metadata), and neither was [Preserve]
  on the classes. Assets-level link.xml is the location Unity reliably scans.
-->
<linker>
  <assembly fullname="StudioKit" preserve="all"/>
  <assembly fullname="StudioKit.Ads.AdMob"        preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="StudioKit.Analytics.Meta"   preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="StudioKit.Analytics.TikTok" preserve="all" ignoreIfMissing="1"/>
</linker>
