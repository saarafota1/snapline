<!--
  Preserves the StudioKit vendor adapters from the IL2CPP managed linker.

  Generated by StudioKit.EditorTools.LinkerPreserve. Do not delete: without it the adapters are
  stripped from release builds and the game ships with no ads and no attribution, while looking
  completely healthy. See PLAYBOOK, "IL2CPP strips every self-registering adapter".

  Must live in Assets. A link.xml inside the kit package is not honoured.
-->
<linker>
  <assembly fullname="StudioKit" preserve="all"/>
  <assembly fullname="StudioKit.Ads.AdMob"        preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="StudioKit.Ads.LevelPlay"    preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="StudioKit.Consent.Ump"      preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="StudioKit.Analytics.Meta"   preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="StudioKit.Analytics.TikTok" preserve="all" ignoreIfMissing="1"/>
</linker>
