<!--
  Keeps Snapline's self-registering service adapters through the IL2CPP managed linker. Nothing
  calls them by name - they register themselves before the first scene - so without this a release
  build strips them and ships with no analytics while looking healthy. The kit's adapters, LevelPlay
  and native UMP consent among them, are preserved by the kit's own Assets/StudioKit/link.xml, and
  the kit's AdapterAudit does not check this assembly: Tools/ArtifactCheck does.
-->
<linker>
  <assembly fullname="Snapline.Services" preserve="all"/>

  <!--
    StudioKit.Ugs holds the leaderboard adapter, and registers itself from a
    RuntimeInitializeOnLoadMethod - nothing names the type, so IL2CPP is free to strip the assembly
    and the game ships with scores that go nowhere and a WORLD board that is simply empty. The kit
    generates its own link.xml and that list does NOT include this assembly (it covers the ad,
    consent, store and attribution adapters), so Snapline preserves it here. Tell the kit owner.
  -->
  <assembly fullname="StudioKit.Ugs" preserve="all" ignoreIfMissing="1"/>
</linker>
