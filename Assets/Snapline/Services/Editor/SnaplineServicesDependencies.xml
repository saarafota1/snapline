<!--
  Native Android libraries for Snapline's own service adapters, read by the dependency resolver.

  Firebase Analytics: the version the Firebase Android BoM 34.19.0 pins. The resolver cannot read a
  BoM, so the version it names is written out here.

  UMP, Google's consent form, is deliberately not listed. The kit's StudioKit.Consent.Ump drives it,
  and LevelPlay's AdMob adapter already brings UMP 4.0.0 in as a dependency of ads-mobile-sdk 1.3.1.
-->
<dependencies>
  <androidPackages>
    <androidPackage spec="com.google.firebase:firebase-analytics:23.2.0">
      <repositories>
        <repository>https://maven.google.com/</repository>
      </repositories>
    </androidPackage>
  </androidPackages>
</dependencies>
